---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for post in site.posts -%}
    {%- unless post.published == false or post.sitemap == false -%}
      {%- assign post_url = post.url | replace:'index.html','' -%}
      <url>
        <loc>https://kite-mallorca.com{{ site.baseurl }}{{ post_url }}</loc>
        {%- if post.modified -%}
          <lastmod>{{ post.modified | date: "%Y-%m-%d" }}</lastmod>
        {%- elsif post.date -%}
          <lastmod>{{ post.date | date: "%Y-%m-%d" }}</lastmod>
        {%- endif -%}
      </url>
    {%- endunless -%}
  {%- endfor -%}

  {%- for page in site.pages -%}
    {%- assign page_url = page.url | replace:'index.html','' -%}
    {%- unless page.url contains '/amp/' or page.sitemap == false or page.layout == nil or page_url contains '.xml' or page_url contains '.txt' or page_url contains '.json' or page_url contains '.css' or page_url contains '.js' or page_url contains 'whatsapp.html' or page_url contains 'en.html' or page_url contains 'pimp_yo_ride' or page_url contains 'redirect' -%}
      <url>
        <loc>https://kite-mallorca.com{{ site.baseurl }}{{ page_url }}</loc>
        {%- if page.modified -%}
          <lastmod>{{ page.modified | date: "%Y-%m-%d" }}</lastmod>
        {%- elsif page.date -%}
          <lastmod>{{ page.date | date: "%Y-%m-%d" }}</lastmod>
        {%- endif -%}
      </url>
    {%- endunless -%}
  {%- endfor -%}
</urlset>